[Unit]
Description=Sistema Integrado Pavageau FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pvg-api
Group=pvg-api
WorkingDirectory=/backend/pvg-system/current
EnvironmentFile=/backend/pvg-system/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/backend/pvg-system/current/.venv/bin/uvicorn app.api.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/backend/pvg-system/logs

[Install]
WantedBy=multi-user.target
