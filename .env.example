# Local/producao
AWS_REGION=sa-east-1

# Supabase Auth/API. Nunca coloque service_role no frontend.
SUPABASE_URL=https://rforddrnuwtaefxojfte.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ALLOWED_EMAILS=gacamargo2003@gmail.com

# Backend API. Use credenciais reais apenas no .env local/hosting, nao neste exemplo.
ENABLE_API_DOCS=1
DATABASE_URL=postgresql://postgres:<password>@db.rforddrnuwtaefxojfte.supabase.co:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.rforddrnuwtaefxojfte.supabase.co:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker do radar: deve usar a role dedicada radar_worker, com senha definida fora do Git.
# Quando RADAR_API_URL estiver definido, o executor local usa a API remota em vez
# de gravar direto no banco.
RADAR_API_URL=
RADAR_API_ACCESS_TOKEN=
RADAR_API_EMAIL=
RADAR_API_PASSWORD=
RADAR_DB_URL=postgresql://radar_worker:<password>@db.rforddrnuwtaefxojfte.supabase.co:5432/postgres?sslmode=require
# Chave simetrica local para criptografar/decriptografar senhas processuais no cofre privado do banco.
# Gere no .env real com 32+ caracteres aleatorios. Nao versionar o valor real.
RADAR_PASSWORD_KEY=
RADAR_CHROMIUM_PATH=/usr/bin/chromium
# Para TJSP em Docker/Oracle, prefira Chrome nao-headless via Xvfb.
RADAR_BROWSER_HEADLESS=0
RADAR_BROWSER_HEADLESS_API=0
RADAR_CHROME_USER_DATA_DIR=.drissionpage/tjsp/perfil
RADAR_CHROME_PROFILE_DIRECTORY=Default
RADAR_CHROME_PORT=
# Opcional: use um Chrome local/visivel ja aberto com --remote-debugging-port=9222.
RADAR_CHROME_ADDRESS=

# Vault/secrets operacionais
VAULT_PROVIDER=memory
SUPABASE_VAULT_KEY_ID=

# Email/notificacoes — relatorio de monitoramento do Radar.
# Destinatario: usa RADAR_ALERT_EMAIL; se vazio, cai para o 1o de SUPABASE_ALLOWED_EMAILS.
RADAR_ALERT_EMAIL=
# Opcao A (recomendada): Resend (API HTTP, funciona de qualquer servidor).
#   Crie uma chave em resend.com e defina RESEND_API_KEY. SMTP_FROM deve ser um
#   remetente de dominio verificado (ou onboarding@resend.dev para testes).
RESEND_API_KEY=
# Opcao B: SMTP direto. Para Gmail use uma "Senha de app" (nao a senha normal):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=seu@gmail.com
#   SMTP_PASSWORD=<app password de 16 letras>  SMTP_FROM="Radar Pavageau <seu@gmail.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Futuro frontend
VITE_SUPABASE_URL=https://rforddrnuwtaefxojfte.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Testes manuais opcionais de Auth real. Nunca versionar valores reais.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=
SUPABASE_TEST_ACCESS_TOKEN=
